# ── Supabase (Project Settings → API, and Connect → Session pooler) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Employees must verify an address on this domain AND hold an approved membership.
EMPLOYEE_EMAIL_DOMAIN=azentio.com

# ── AIRA (Groq, OpenAI-compatible API) ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Email (Resend). Without a key, mail stays "queued" and is never shown as delivered. ──
RESEND_API_KEY=
EMAIL_FROM=azentio.ai <onboarding@resend.dev>

# ── Judging / demo ──
# DEMO_MODE enables the labelled persona switcher on /login (password sign-in for seeded
# synthetic accounts). Turn it off in production.
DEMO_MODE=true
DEMO_PASSWORD=
# Shared secrets for the outbox worker and the federated-learning coordinator.
CRON_SECRET=
FL_INGEST_TOKEN=
# Minimum distinct contributing organisations before trend statistics are shown.
MIN_COHORT_ORGS=3
